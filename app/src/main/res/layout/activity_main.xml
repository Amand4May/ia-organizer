<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cor_fundo"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/textBomDia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="24dp"
        android:text="BOM DIA"
        android:textColor="@color/ciano"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textSaudacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:text="Vamos organizar, \nAmanda?"
        android:textColor="#E3E3E3"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/textBomDia"
        app:layout_constraintTop_toBottomOf="@id/textBomDia" />

    <!-- Barra de Input -->
    <LinearLayout
        android:id="@+id/barraDigitacao"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_input_home"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/textSaudacao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/azul_safira" />

        <EditText
            android:id="@+id/inputComando"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:hint="Peça ao Organizador..."
            android:textColorHint="#8E8E8E"
            android:textColor="#E3E3E3"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnEnviar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_send"
            android:src="@android:drawable/ic_menu_send"
            android:padding="8dp"
            app:tint="@color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/labelProximas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Próximas tarefas"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/barraDigitacao"
        app:layout_constraintStart_toStartOf="@id/barraDigitacao" />

    <TextView
        android:id="@+id/labelVerTudo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ver tudo"
        android:textColor="@color/ciano"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/labelProximas"
        app:layout_constraintEnd_toEndOf="@id/barraDigitacao"
        app:layout_constraintTop_toTopOf="@id/labelProximas" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaTarefas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/labelProximas"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_bottom_nav"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:itemActiveIndicatorStyle="@null"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>