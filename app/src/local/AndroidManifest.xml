<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- A cópia local nunca tem acesso à rede nem inicializa o Firebase. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <application android:label="Cogni Local" android:allowBackup="false" tools:replace="android:label,android:allowBackup">
        <provider android:name="com.google.firebase.provider.FirebaseInitProvider" android:authorities="${applicationId}.firebaseinitprovider" tools:node="remove" />
    </application>
</manifest>
